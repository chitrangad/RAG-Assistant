{
  "manifest_version": 3,
  "name": "Project Knowledge Assistant",
  "version": "0.1.0",
  "description": "Augment AI chats with grounded evidence from your project documents via local RAG backend.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.cloud.microsoft/*",
    "https://gemini.google.com/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Project Knowledge Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.cloud.microsoft/*",
        "https://gemini.google.com/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["providers/registry.js", "providers/copilot.js", "providers/gemini.js", "providers/chatgpt.js", "providers/claude.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
