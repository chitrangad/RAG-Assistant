# Copy to `.env` and adjust. Used by docker-compose.yml.

# Host port the app is exposed on (the container always listens on 8000).
PORT=8000

# Host directory for persistent data: SQLite catalog, ChromaDB, uploads,
# LLM settings, and the downloaded answer model (under <DATA_DIR>/models).
DATA_DIR=./data

# Optional: mount a host directory or network share into the container so it
# can be ingested. Uncomment the corresponding volume in docker-compose.yml.
# NETWORK_SHARE_PATH=/mnt/your-share
